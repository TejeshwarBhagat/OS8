+// Read the allocator's free-page count under the allocator lock.
+int
+kfreepages(void)
+{
+  int n;
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  n = kmem.free_pages;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+  return n;
+}
+
+// Pages managed by the allocator, excluding the kernel image and reserved RAM.
+int
+ktotalpages(void)
+{
+  return (PHYSTOP - PGROUNDUP(V2P(end))) / PGSIZE;
+}
