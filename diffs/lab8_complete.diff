+// Translate a user virtual address to its physical address, preserving offset.
+// Return -1 for unmapped pages and supervisor-only mappings such as the guard.
+int
+va2pa(pde_t *pgdir, uint va)
+{
+  int pa;
+  pte_t *pte;
+
+  pte = va < KERNBASE ? walkpgdir(pgdir, (char*)va, 0) : 0;
+  if(pte == 0 || (*pte & (PTE_P|PTE_U)) != (PTE_P|PTE_U)){
+    cprintf("va2pa: VA=%x PDI=%d PTI=%d offset=%x P=%d W=%d U=%d -> -1\n",
+            va, PDX(va), PTX(va), va & (PGSIZE-1),
+            pte ? !!(*pte&PTE_P) : 0, pte ? !!(*pte&PTE_W) : 0,
+            pte ? !!(*pte&PTE_U) : 0);
+    return -1;
+  }
+  pa = (int)(PTE_ADDR(*pte) | (va & (PGSIZE-1)));
+  cprintf("va2pa: VA=%x PDI=%d PTI=%d offset=%x P=%d W=%d U=%d -> PA=%x\n",
+          va, PDX(va), PTX(va), va & (PGSIZE-1), !!(*pte&PTE_P),
+          !!(*pte&PTE_W), !!(*pte&PTE_U), pa);
+  return pa;
+}
+
+// Dump user mappings. Kernel PTEs are counted separately to keep output short.
+void
+vmprint(pde_t *pgdir)
+{
+  int i, j, userpages, guardpages, kernelentries;
+  pte_t *pt;
+  pde_t pde;
+  pte_t pte;
+  uint va;
+
+  userpages = guardpages = kernelentries = 0;
+  cprintf("vmprint: page directory %x\n", V2P(pgdir));
+  for(i = 0; i < NPDENTRIES; i++){
+    pde = pgdir[i];
+    if((pde & PTE_P) == 0)
+      continue;
+    pt = (pte_t*)P2V(PTE_ADDR(pde));
+    if(i >= PDX(KERNBASE)){
+      for(j = 0; j < NPTENTRIES; j++)
+        if(pt[j] & PTE_P)
+          kernelentries++;
+      continue;
+    }
+    cprintf("  PDE[%d] PT=%x flags P=%d W=%d U=%d\n", i,
+            PTE_ADDR(pde), !!(pde&PTE_P), !!(pde&PTE_W), !!(pde&PTE_U));
+    for(j = 0; j < NPTENTRIES; j++){
+      pte = pt[j];
+      if((pte & PTE_P) == 0)
+        continue;
+      va = ((uint)i << 22) | ((uint)j << 12);
+      cprintf("    PTE[%d] VA=%x PA=%x flags P=%d W=%d U=%d\n", j,
+              va, PTE_ADDR(pte), !!(pte&PTE_P), !!(pte&PTE_W), !!(pte&PTE_U));
+      if(pte & PTE_U)
+        userpages++;
+      else
+        guardpages++;
+    }
+  }
+  cprintf("vmprint: user pages=%d guard pages=%d; kernel entries omitted=%d\n",
+          userpages, guardpages, kernelentries);
+}
+
+// Resolve a not-present access to a page in the process's lazy heap.
+// Existing user mappings are already resolved; guard and out-of-range pages fail.
+int
+vmfault(struct proc *p, uint va)
+{
+  uint page;
+  pte_t *pte;
+  char *mem;
+
+  if(p == 0 || va >= p->sz || va < p->heapbase)
+    return -1;
+  page = PGROUNDDOWN(va);
+  if(p->stackguard != 0xffffffff &&
+     page >= p->stackguard && page < p->stackguard + PGSIZE)
+    return -1;
+  pte = walkpgdir(p->pgdir, (char*)page, 0);
+  if(pte && (*pte & PTE_P))
+    return (*pte & PTE_U) ? 0 : -1;
+  if((mem = kalloc()) == 0)
+    return -1;
+  memset(mem, 0, PGSIZE);
+  if(mappages(p->pgdir, (char*)page, PGSIZE, V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
+  return 0;
+}
